model ServiceVariant {
  id                 String      @id @default(cuid())
  serviceId          String
  name               String
  description        String?
  priceAdjustment    Decimal     @db.Decimal(10, 2) // Can be positive or negative
  durationAdjustment Int         @default(0) // Minutes to add/subtract
  type               VariantType @default(OPTION)
  isDefault          Boolean     @default(false)
  order              Int         @default(0)
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([serviceId, order])
  @@map("service_variants")
}

enum VariantType {
  OPTION // Choice variants (e.g., Short/Medium/Long hair)
  ADDON // Optional add-ons (e.g., Deep conditioning)
}

