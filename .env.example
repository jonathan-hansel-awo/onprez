# Application identity and canonical URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=OnPrez
APP_URL=http://localhost:3000
FROM_EMAIL=noreply@onprez.com
FROM_NAME=OnPrez
SUPPORT_EMAIL=support@onprez.com

# PostgreSQL / Neon. Use isolated local or preview credentials here, never production.
DATABASE_URL=postgresql://onprez:replace-me@localhost:5432/onprez
DIRECT_URL=postgresql://onprez:replace-me@localhost:5432/onprez

# Custom authentication and token protection. Replace every example with an independent secret.
JWT_SECRET=replace-with-at-least-32-random-characters
EMAIL_VERIFICATION_TOKEN_PEPPER=replace-with-an-independent-random-pepper
PASSWORD_RESET_TOKEN_PEPPER=replace-with-an-independent-random-pepper
MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
MFA_BACKUP_CODE_PEPPER=replace-with-an-independent-random-pepper
MFA_TEMP_TOKEN_PEPPER=replace-with-an-independent-random-pepper
TRUSTED_DEVICE_PEPPER=replace-with-an-independent-random-pepper

# Transactional email
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=

# Cloudinary media delivery
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Optional consented analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional error monitoring and source-map upload
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=development

# Optional Stripe Connect and booking deposits
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/business/calendar/google/callback
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Optional Web Push. Generate with `npm run push:generate-vapid`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@onprez.com

# Protects scheduled booking-approval and push-delivery routes. Minimum 32 characters.
CRON_SECRET=
