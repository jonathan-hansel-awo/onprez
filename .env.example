MFA_ENCRYPTION_KEY=
MFA_BACKUP_CODE_PEPPER=
MFA_TEMP_TOKEN_PEPPER=
TRUSTED_DEVICE_PEPPER=0

# Optional analytics (only used after visitor consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Error monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=production

# Resend delivery webhooks (signing secret from the Resend webhook details page)
RESEND_WEBHOOK_SECRET=

# Stripe Connect and booking deposits (optional until Booking Protection is enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Calendar OAuth (create a Web application OAuth client in Google Cloud)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Web Push (generate once with `npm run push:generate-vapid`, then keep the private key secret)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@onprez.com
CRON_SECRET=
